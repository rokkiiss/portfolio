---
import Layout from '../layouts/Layout.astro';

const skills = {
  "Technology Leadership": [
    "Cloud Architecture (AWS, Azure)",
    "Digital Transformation",
    "Enterprise Architecture",
    "Cybersecurity Strategy",
    "IT Infrastructure & Operations",
    "DevSecOps / Agile Delivery",
  ],
  "Business & Strategy": [
    "IT Budget & P&L Management",
    "Vendor & Contract Negotiation",
    "M&A Technology Integration",
    "Business Continuity Planning",
    "Regulatory Compliance (SOC2, CMMC, HIPAA)",
    "Board-Level Reporting",
  ],
  "People & Org": [
    "Building & Scaling Engineering Teams",
    "Cross-Functional Leadership",
    "C-Suite Collaboration",
    "Change Management",
    "Mentorship & Talent Development",
    "Stakeholder Communication",
  ],
};

const timeline = [
  {
    role: "Chief Information Officer",
    company: "Jaydien Inc.",
    period: "2020 — Present",
    location: "Remote / National",
    highlights: [
      "Led enterprise-wide digital transformation reducing operational costs by 35%",
      "Built and scaled a 40+ person IT organization from the ground up",
      "Drove cloud migration strategy cutting infrastructure spend by $2.4M annually",
      "Established cybersecurity framework achieving SOC 2 Type II certification",
    ],
  },
  {
    role: "VP of Information Technology",
    company: "Previous Company",
    period: "2015 — 2020",
    location: "Washington, D.C.",
    highlights: [
      "Overhauled legacy systems supporting 500+ users across 12 locations",
      "Negotiated vendor contracts delivering $1.8M in annual savings",
      "Led CMMC compliance initiative for DoD contract eligibility",
      "Championed agile delivery model cutting project delivery time by 40%",
    ],
  },
  {
    role: "Director of IT Operations",
    company: "Prior Organization",
    period: "2010 — 2015",
    location: "Northern Virginia",
    highlights: [
      "Directed $8M infrastructure refresh program on time and under budget",
      "Implemented ITSM framework (ServiceNow) across the enterprise",
      "Reduced mean time to resolution (MTTR) by 60% through process automation",
    ],
  },
];
---

<Layout>
  <!-- ── NAV BAR ── -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <span class="text-navy font-semibold tracking-wide text-sm uppercase" style="color:#1a1a2e">Roger Anderson</span>
      <div class="hidden sm:flex items-center gap-8 text-sm font-medium text-gray-500">
        <a href="#about" class="hover:text-navy transition-colors" style="--hover:#1a1a2e">About</a>
        <a href="#timeline" class="hover:text-gray-900 transition-colors">Career</a>
        <a href="#skills" class="hover:text-gray-900 transition-colors">Skills</a>
        <a
          href="mailto:randerson@jaydien.com"
          class="px-4 py-2 rounded text-white text-sm font-medium transition-opacity hover:opacity-90"
          style="background:#1a1a2e"
        >
          Contact
        </a>
      </div>
    </div>
  </nav>

  <!-- ── HERO ── -->
  <section id="about" class="pt-16 min-h-screen flex flex-col justify-center" style="background:linear-gradient(to bottom, #f8fafc 0%, #ffffff 100%)">
    <div class="max-w-6xl mx-auto px-6 py-24 grid lg:grid-cols-2 gap-16 items-center">
      <!-- Text -->
      <div>
        <p class="text-sm font-medium uppercase tracking-widest mb-4" style="color:#1a1a2e">Executive IT Leader</p>
        <h1 class="serif text-5xl lg:text-6xl font-bold leading-tight mb-6 text-gray-900">
          Roger<br />Anderson
        </h1>
        <p class="text-lg text-gray-500 font-light mb-2 tracking-wide">CIO &nbsp;·&nbsp; CTO &nbsp;·&nbsp; VP of IT</p>

        <div class="w-12 h-0.5 my-8" style="background:#1a1a2e"></div>

        <p class="text-lg text-gray-700 leading-relaxed max-w-md">
          Senior technology executive with 15+ years driving digital transformation,
          building high-performing IT organizations, and aligning technology strategy
          with business outcomes — from the boardroom to the cloud.
        </p>

        <div class="mt-10 flex items-center gap-4 flex-wrap">
          <a
            href="#timeline"
            class="px-6 py-3 rounded text-white text-sm font-medium transition-opacity hover:opacity-90"
            style="background:#1a1a2e"
          >
            View Career History
          </a>
          <a
            href="https://www.linkedin.com/in/rogerander/"
            target="_blank"
            rel="noopener"
            class="px-6 py-3 rounded text-sm font-medium border border-gray-300 text-gray-700 hover:border-gray-400 transition-colors"
          >
            LinkedIn Profile ↗
          </a>
        </div>
      </div>

      <!-- Stats / Quick Wins -->
      <div class="grid grid-cols-2 gap-6">
        {[
          { stat: "15+", label: "Years of Executive IT Leadership" },
          { stat: "$10M+", label: "IT Budgets Managed" },
          { stat: "40+", label: "Person Teams Built & Led" },
          { stat: "3x", label: "Compliance Frameworks Implemented" },
        ].map(({ stat, label }) => (
          <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-3xl font-bold mb-2" style="color:#1a1a2e; font-family:'Playfair Display',serif">{stat}</p>
            <p class="text-sm text-gray-500 leading-snug">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CAREER TIMELINE ── -->
  <section id="timeline" class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-16">
        <p class="text-sm font-medium uppercase tracking-widest mb-3 text-gray-400">Professional History</p>
        <h2 class="serif text-4xl font-bold text-gray-900">Career Timeline</h2>
      </div>

      <div class="space-y-10">
        {timeline.map((role, i) => (
          <div class="group relative grid lg:grid-cols-[220px_1fr] gap-6 lg:gap-12 items-start">
            <!-- Period -->
            <div class="lg:text-right lg:pt-1">
              <p class="text-sm font-semibold text-gray-900">{role.period}</p>
              <p class="text-xs text-gray-400 mt-1">{role.location}</p>
            </div>

            <!-- Content card -->
            <div class="relative pl-6 border-l-2 border-gray-100 group-hover:border-l-2 transition-all"
                 style="border-left-color:#e2e8f0">
              <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-gray-300 group-hover:bg-navy transition-colors"
                   style=""></div>
              <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm group-hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between gap-4 mb-4">
                  <div>
                    <h3 class="text-xl font-bold text-gray-900">{role.role}</h3>
                    <p class="text-sm font-medium mt-0.5" style="color:#1a1a2e">{role.company}</p>
                  </div>
                </div>
                <ul class="space-y-2">
                  {role.highlights.map((h) => (
                    <li class="flex items-start gap-2 text-sm text-gray-600">
                      <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:#1a1a2e"></span>
                      {h}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SKILLS ── -->
  <section id="skills" class="py-24" style="background:#f8fafc">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-16">
        <p class="text-sm font-medium uppercase tracking-widest mb-3 text-gray-400">Capabilities</p>
        <h2 class="serif text-4xl font-bold text-gray-900">Skills &amp; Expertise</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {Object.entries(skills).map(([category, items]) => (
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <h3 class="font-semibold text-sm uppercase tracking-wider mb-6 pb-3 border-b border-gray-100" style="color:#1a1a2e">
              {category}
            </h3>
            <ul class="space-y-3">
              {items.map((skill) => (
                <li class="flex items-center gap-2.5 text-sm text-gray-700">
                  <svg class="w-3.5 h-3.5 flex-shrink-0 opacity-40" viewBox="0 0 24 24" fill="currentColor" style="color:#1a1a2e">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                  </svg>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <footer class="py-12 border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-400">Roger Anderson &mdash; IT Executive</p>
      <div class="flex items-center gap-6 text-sm text-gray-400">
        <a href="mailto:randerson@jaydien.com" class="hover:text-gray-700 transition-colors">randerson@jaydien.com</a>
        <a href="https://linkedin.com" target="_blank" class="hover:text-gray-700 transition-colors">LinkedIn ↗</a>
        <a href="https://github.com/rokkiiss" target="_blank" class="hover:text-gray-700 transition-colors">GitHub ↗</a>
      </div>
    </div>
  </footer>
</Layout>
