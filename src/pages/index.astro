---
import Layout from '../layouts/Layout.astro';

const chapters = [
  {
    num: "01",
    role: "PC Warehouse",
    title: "Where It Started",
    period: "Early Career",
    location: "NJ",
    color: "#38bdf8",
    summary: "First exposure to technology — hardware, troubleshooting, and the realization that IT was the path.",
    highlights: [
      "First hands-on experience with computer hardware and repair",
      "Discovered a passion for problem-solving through technology",
      "Built foundational knowledge that everything else would grow from",
    ],
  },
  {
    num: "02",
    role: "Verizon Wireless",
    title: "Learning the Business Side",
    period: "Early Career",
    location: "NJ",
    color: "#f59e0b",
    summary: "Learned how technology connects to business outcomes and customer experience at scale.",
    highlights: [
      "Developed client-facing communication and technical explanation skills",
      "Gained exposure to enterprise-scale technology and operations",
      "Understood how IT decisions directly impact business and customers",
    ],
  },
  {
    num: "03",
    role: "Tech-Keys",
    title: "Found My Meaning in IT",
    period: "2016 — 2022",
    location: "Howell, NJ",
    color: "#6366f1",
    summary: "The place where everything clicked. Grew from Level 1 technician all the way to HelpDesk Manager — and built the leadership skills that define the rest of the story.",
    highlights: [
      "Started as a Level 1 technician — learned from the ground up",
      "Managed and configured Aruba, Dell, Cisco switches and SonicWall Firewalls",
      "Deployed and maintained Hyper-V, VMware, and Azure cloud environments",
      "Promoted to HelpDesk Manager — led a team of 10+ support engineers",
      "Improved SLA response times by 50% for Tier 1 and 30% across all other tiers",
      "Implemented ITIL practices that brought structure and accountability to the team",
      "Built an educational program for interns and engineers to accelerate growth",
    ],
  },
  {
    num: "04",
    role: "AFScott",
    title: "Putting It All Into Practice",
    period: "2022 — 2024",
    location: "Bedminster, NJ",
    color: "#a78bfa",
    summary: "Took everything learned at Tech-Keys and applied it at scale. Drove transformational improvements across service delivery and team performance.",
    highlights: [
      "Increased SLA compliance by 40% through strategic process improvements",
      "Drove overall team productivity up by 85%",
      "Built automation using PowerShell and Bash that eliminated manual workloads",
      "Managed Azure AD, Active Directory, Hyper-V, VMware, and Citrix environments",
      "Deployed Azure MFA, SSO, and Power Automate to modernize security and workflows",
      "Managed client relationships and escalations across a complex service delivery model",
    ],
  },
  {
    num: "05",
    role: "Jaydien Network Solutions",
    title: "Zero to Hero — The Culmination",
    period: "June 2024 — Present",
    location: "Brick, NJ",
    color: "#34d399",
    summary: "This is where every lesson, every late night, every hard conversation, and every solved problem converged. The full stack — operations, leadership, strategy, and execution.",
    highlights: [
      "Grew technician utilization from 20% to 70% through workflow redesign and automation",
      "Own end-to-end IT operations for a managed services environment serving regulated industries",
      "Manage the full Microsoft stack: Entra ID, Intune, Autopilot, M365, Exchange, SharePoint, Teams",
      "Handle network infrastructure including Meraki environments and VPN across distributed offices",
      "Lead technology projects from initial scoping through go-live",
      "Mentor the technical team and drive operational metrics, budget planning, and technology roadmap",
      "Deliver executive-level reporting on system health, risk, and investment priorities",
    ],
  },
];

const skills = [
  { label: "Microsoft 365 & Entra ID", level: 95 },
  { label: "Azure AD & Cloud Services", level: 90 },
  { label: "PowerShell & Bash Automation", level: 88 },
  { label: "Network Infrastructure (Meraki, Cisco, SonicWall)", level: 85 },
  { label: "ITIL & Service Management", level: 90 },
  { label: "Hyper-V & VMware", level: 82 },
  { label: "Vendor & Contract Management", level: 88 },
  { label: "Team Leadership & Mentorship", level: 92 },
];
---

<Layout title="Roger Anderson — IT Leader" description="IT Operations & Service Delivery Leader, NY Metro Area">

  <!-- NAV -->
  <nav style="position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(13,17,23,0.85);backdrop-filter:blur(12px);border-bottom:1px solid #30363d;">
    <div style="max-width:1100px;margin:0 auto;padding:0 1.5rem;height:64px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-weight:600;font-size:0.9rem;letter-spacing:0.05em;text-transform:uppercase;color:#e6edf3;">Roger Anderson</span>
      <div style="display:flex;align-items:center;gap:2rem;">
        <a href="#story" class="nav-link">Story</a>
        <a href="#skills" class="nav-link">Skills</a>
        <a href="https://linkedin.com/in/rokis" target="_blank" rel="noopener"
           style="padding:0.5rem 1.25rem;border-radius:6px;background:#6366f1;color:white;font-size:0.85rem;font-weight:500;text-decoration:none;">
          LinkedIn ↗
        </a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:6rem 1.5rem 4rem;position:relative;overflow:hidden;">
    <!-- Background glow -->
    <div style="position:absolute;top:20%;left:50%;transform:translateX(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(99,102,241,0.12) 0%,transparent 70%);pointer-events:none;"></div>

    <div style="max-width:1100px;margin:0 auto;width:100%;">
      <p style="color:#6366f1;font-size:0.85rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:1.5rem;">Director of IT · NY Metro Area</p>

      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(3.5rem,8vw,7rem);font-weight:900;line-height:1.05;margin-bottom:1.5rem;">
        <span style="color:#e6edf3;">Roger</span><br/>
        <span class="gradient-text">Anderson</span>
      </h1>

      <p style="font-size:1.25rem;color:#8b949e;font-weight:300;max-width:600px;line-height:1.7;margin-bottom:3rem;">
        From fixing computers at a PC shop to running IT operations for a managed services firm —
        this is a decade of growth, hard-won expertise, and building teams that deliver.
      </p>

      <!-- Stats row -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1.5rem;max-width:700px;margin-bottom:3.5rem;">
        {[
          { stat: "10+", label: "Years in IT" },
          { stat: "85%", label: "Productivity lift at AFScott" },
          { stat: "3.5×", label: "Utilization growth at Jaydien" },
          { stat: "50%", label: "SLA improvement at Tech-Keys" },
        ].map(({ stat, label }) => (
          <div class="card" style="padding:1.25rem;text-align:center;">
            <div class="stat-number">{stat}</div>
            <div style="color:#8b949e;font-size:0.75rem;margin-top:0.25rem;line-height:1.4;">{label}</div>
          </div>
        ))}
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="#story" style="padding:0.75rem 1.75rem;border-radius:8px;background:#6366f1;color:white;font-weight:500;text-decoration:none;font-size:0.95rem;">
          Read the Story ↓
        </a>
        <a href="mailto:roger@yeaitis.com" style="padding:0.75rem 1.75rem;border-radius:8px;border:1px solid #30363d;color:#e6edf3;font-weight:500;text-decoration:none;font-size:0.95rem;">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- STORY / TIMELINE -->
  <section id="story" style="padding:6rem 1.5rem;">
    <div style="max-width:1100px;margin:0 auto;">

      <div style="margin-bottom:5rem;">
        <div class="glow-line" style="margin-bottom:2rem;"></div>
        <p style="color:#6366f1;font-size:0.85rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:0.75rem;">The Journey</p>
        <h2 style="font-family:'Playfair Display',serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:700;color:#e6edf3;">
          Every stop shaped<br/>what came next.
        </h2>
      </div>

      <!-- Timeline -->
      <div style="position:relative;">
        <!-- Vertical line -->
        <div style="position:absolute;left:5px;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,#6366f1,#30363d);"></div>

        <div style="display:flex;flex-direction:column;gap:5rem;">
          {chapters.map((ch) => (
            <div style="display:grid;grid-template-columns:20px 1fr;gap:2rem;position:relative;">
              <!-- Dot -->
              <div style={`width:12px;height:12px;border-radius:50%;background:${ch.color};box-shadow:0 0 16px ${ch.color};flex-shrink:0;margin-top:0.4rem;`}></div>

              <!-- Card -->
              <div class="card" style="padding:2.5rem;position:relative;overflow:hidden;">
                <!-- Big chapter number watermark -->
                <div style="position:absolute;right:-0.5rem;top:-1rem;font-family:'Playfair Display',serif;font-size:8rem;font-weight:900;line-height:1;opacity:0.04;color:#ffffff;user-select:none;pointer-events:none;">
                  {ch.num}
                </div>

                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;flex-wrap:wrap;">
                  <div>
                    <p style={`color:${ch.color};font-size:0.8rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.4rem;`}>
                      Chapter {ch.num} · {ch.period}
                    </p>
                    <h3 style="font-family:'Playfair Display',serif;font-size:1.75rem;font-weight:700;color:#e6edf3;margin-bottom:0.25rem;">
                      {ch.title}
                    </h3>
                    <p style="color:#8b949e;font-size:0.9rem;">{ch.role} · {ch.location}</p>
                  </div>
                </div>

                <p style="color:#8b949e;font-size:0.95rem;line-height:1.7;margin-bottom:1.5rem;font-style:italic;border-left:2px solid;padding-left:1rem;"
                   style={`border-color:${ch.color};`}>
                  {ch.summary}
                </p>

                <ul style="display:flex;flex-direction:column;gap:0.6rem;">
                  {ch.highlights.map((h) => (
                    <li style="display:flex;align-items:flex-start;gap:0.75rem;font-size:0.9rem;color:#c9d1d9;">
                      <span style={`color:${ch.color};margin-top:0.35rem;flex-shrink:0;font-size:0.7rem;`}>▶</span>
                      {h}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" style="padding:6rem 1.5rem;background:#0a0d12;">
    <div style="max-width:1100px;margin:0 auto;">
      <div class="glow-line" style="margin-bottom:2rem;"></div>
      <p style="color:#6366f1;font-size:0.85rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:0.75rem;">Capabilities</p>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:700;color:#e6edf3;margin-bottom:3rem;">
        Skills & Expertise
      </h2>

      <div style="display:flex;flex-direction:column;gap:1.25rem;max-width:800px;">
        {skills.map(({ label, level }) => (
          <div>
            <div style="display:flex;justify-content:space-between;margin-bottom:0.4rem;">
              <span style="font-size:0.9rem;color:#c9d1d9;">{label}</span>
              <span style="font-size:0.85rem;color:#6366f1;font-weight:600;">{level}%</span>
            </div>
            <div style="height:4px;background:#21262d;border-radius:4px;overflow:hidden;">
              <div style={`height:100%;width:${level}%;background:linear-gradient(to right,#6366f1,#38bdf8);border-radius:4px;`}></div>
            </div>
          </div>
        ))}
      </div>

      <!-- Additional skills grid -->
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem;margin-top:3rem;">
        {["Leadership","Risk Mitigation","Security & Compliance","Vendor Management","Project Management","Client Relations","Performance Metrics","IT Automation","Meraki Networks","SonicWall","Citrix","Power Automate"].map((s) => (
          <div style="padding:0.6rem 1rem;background:#161b22;border:1px solid #30363d;border-radius:6px;font-size:0.85rem;color:#8b949e;text-align:center;">
            {s}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FOOTER / CONTACT -->
  <footer style="padding:4rem 1.5rem;border-top:1px solid #30363d;">
    <div style="max-width:1100px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:1.5rem;">
      <h2 style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:#e6edf3;">Let's Connect</h2>
      <p style="color:#8b949e;max-width:400px;">Open to new opportunities, consulting conversations, or just a good IT chat.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;">
        <a href="mailto:roger@yeaitis.com" style="padding:0.75rem 1.75rem;border-radius:8px;background:#6366f1;color:white;font-weight:500;text-decoration:none;">
          roger@yeaitis.com
        </a>
        <a href="https://linkedin.com/in/rokis" target="_blank" rel="noopener" style="padding:0.75rem 1.75rem;border-radius:8px;border:1px solid #30363d;color:#e6edf3;font-weight:500;text-decoration:none;">
          LinkedIn ↗
        </a>
        <a href="https://github.com/rokkiiss" target="_blank" rel="noopener" style="padding:0.75rem 1.75rem;border-radius:8px;border:1px solid #30363d;color:#e6edf3;font-weight:500;text-decoration:none;">
          GitHub ↗
        </a>
      </div>
      <p style="color:#30363d;font-size:0.8rem;margin-top:1rem;">Roger Anderson · Director of IT · NY Metro Area</p>
    </div>
  </footer>

</Layout>
