  .chapter-title { font-family: var(--display); font-weight: 500; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.05; letter-spacing: -.02em; margin: 0 0 16px; color: var(--fg); }
  .chapter-where { font-family: var(--mono); font-size: 13px; color: var(--fg-2); display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--bg-2); }
  .chapter-where .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
  .chapter-body { padding-left: clamp(0px, 8vw, 120px); }
  @media (max-width: 700px) { .chapter-head { flex-direction: column; gap: 8px; } .chapter-body { padding-left: 0; } }
  .chapter-lede { font-size: clamp(18px, 1.6vw, 22px); line-height: 1.5; color: var(--fg); font-weight: 300; margin: 0 0 32px; max-width: 60ch; font-family: var(--body); }
  .achievements { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; max-width: 70ch; }
  .achievements li { display: grid; grid-template-columns: 28px 1fr; gap: 4px; color: var(--fg-2); font-size: 15px; line-height: 1.5; padding: 2px 0; }
  .achievements li::before { content: "▸"; font-family: var(--mono); color: var(--accent); font-size: 12px; line-height: 1.65; }

  /* ── Skills ── */
  .skills { background: var(--bg-2); }
  .domains-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 64px; margin-top: 72px; }
  @media (max-width: 900px) { .domains-grid { grid-template-columns: 1fr; gap: 48px; } }
  .domain {}
  .domain-header { margin-bottom: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .domain-name { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin: 0; font-weight: 400; }
  .skill-list { display: flex; flex-direction: column; gap: 18px; }
  .skill-row { display: flex; flex-direction: column; gap: 8px; }
  .skill-row-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .skill-name { font-family: var(--body); font-size: 14px; color: var(--fg); font-weight: 400; }
  .skill-pct { font-family: var(--mono); font-size: 12px; color: var(--fg-3); font-variant-numeric: tabular-nums; flex-shrink: 0; }
  .skill-bar { position: relative; height: 3px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .skill-bar-fill { position: absolute; inset: 0 auto 0 0; width: 0; background: linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 100%); border-radius: inherit; transition: width 1.4s cubic-bezier(.2,.7,.2,1); }
  .skill-bar-fill::after { content: ""; position: absolute; right: 0; top: -3px; width: 8px; height: 9px; background: var(--accent); border-radius: 2px; box-shadow: 0 0 12px var(--accent); opacity: .9; }
  .tools-row { margin-top: 56px; }
  .tools-row .tags { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { font-family: var(--mono); font-size: 12px; padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--fg-2); background: var(--bg-3); transition: color .2s, border-color .2s, background .2s; }
  .tag:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .languages-row { margin-top: 40px; }
  .lang-list { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .lang-tag { font-family: var(--mono); font-size: 13px; padding: 10px 20px; border-radius: 999px; border: 1px solid var(--accent); color: var(--accent); background: var(--accent-soft); letter-spacing: .04em; }

  /* ── Contact ── */
  .contact { border-top: 1px solid var(--line); background: var(--bg); }
  .contact-inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 80px; align-items: start; }
  @media (max-width: 900px) { .contact-inner { grid-template-columns: 1fr; gap: 48px; } }
  .contact-cta { font-family: var(--display); font-weight: 500; font-size: clamp(40px, 6vw, 88px); line-height: 1.0; letter-spacing: -.03em; margin: 24px 0 32px; color: var(--fg); }
  .contact-cta em { font-family: var(--serif); font-style: italic; color: var(--accent); }
  .contact-blurb { color: var(--fg-2); max-width: 48ch; font-size: 17px; line-height: 1.5; }
  .contact-card { border: 1px solid var(--line-strong); border-radius: 16px; padding: 28px; background: var(--bg-2); display: flex; flex-direction: column; gap: 4px; }
  .contact-card .label { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-3); margin-bottom: 6px; }
  .contact-line { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; border-top: 1px solid var(--line); transition: padding-left .2s; }
  .contact-line:hover { padding-left: 4px; }
  .contact-line:first-of-type { border-top: 0; padding-top: 12px; }
  .contact-line .what { font-family: var(--mono); font-size: 12px; color: var(--fg-3); letter-spacing: .04em; }
  .contact-line .val { font-family: var(--body); font-size: 17px; color: var(--fg); display: inline-flex; gap: 8px; align-items: center; }
  .contact-line .val .arrow { color: var(--accent); transition: transform .2s; }
  .contact-line:hover .val .arrow { transform: translate(2px, -2px); }

  /* ── Footer ── */
  footer { border-top: 1px solid var(--line); padding: 32px 0; font-family: var(--mono); font-size: 12px; color: var(--fg-3); }
  .footer-inner { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .footer-links { display: flex; gap: 20px; }
  .footer-links a:hover { color: var(--accent); }
</style>

<script>
// ── Scroll reveal ───────────────────────────────────────────────────────────
const revealEls = document.querySelectorAll('.reveal');
const revealIO = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });
revealEls.forEach(el => {
  const r = el.getBoundingClientRect();
  if (r.top < window.innerHeight && r.bottom > 0) { el.classList.add('in'); }
  else { revealIO.observe(el); }
});

// ── Count-up helper ─────────────────────────────────────────────────────────
function countUp(el, target, duration, decimals, delay) {
  setTimeout(() => {
    const start = performance.now();
    const ease = t => 1 - Math.pow(1 - t, 3);
    const tick = (now) => {
      const t = Math.min(1, (now - start) / duration);
      const v = target * ease(t);
      el.textContent = decimals > 0 ? v.toFixed(decimals) : Math.round(v);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }, delay);
}

// ── Sparkline draw-in ───────────────────────────────────────────────────────
function initSparklines() {
  document.querySelectorAll('.spark-line').forEach(line => {
    try {
      const len = line.getTotalLength();
      line.style.strokeDasharray = len;
      line.style.strokeDashoffset = len;
    } catch(_) {
      line.style.strokeDasharray = 115;
      line.style.strokeDashoffset = 115;
    }
  });
}

function fireSparks() {
  document.querySelectorAll('.spark-line').forEach((line, i) => {
    setTimeout(() => {
      line.style.transition = 'stroke-dashoffset 1.6s cubic-bezier(.2,.7,.2,1)';
      line.style.strokeDashoffset = '0';
    }, 200 + i * 80);
  });
}

initSparklines();

// ── Hero metric count-up + sparks ───────────────────────────────────────────
const metricVals = document.querySelectorAll('.metric-val');
let metricsFired = false;

function fireMetrics() {
  if (metricsFired) return;
  metricsFired = true;
  metricVals.forEach(el => {
    const raw = el.dataset.count;
    const target = parseFloat(raw);
    const decimals = raw.includes('.') ? 1 : 0;
    const delay = parseInt(el.dataset.delay) || 0;
    countUp(el, target, 1400, decimals, delay);
  });
  fireSparks();
}

const heroEl = document.getElementById('top');
if (heroEl) {
  const r = heroEl.getBoundingClientRect();
  if (r.top < window.innerHeight) { fireMetrics(); }
  else {
    const heroIO = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) { fireMetrics(); heroIO.disconnect(); }
    }, { threshold: 0.05 });
    heroIO.observe(heroEl);
  }
}

// ── Skill bars + count-up ───────────────────────────────────────────────────
const skillFills = document.querySelectorAll('.skill-bar-fill');
const skillPctNums = document.querySelectorAll('.skill-pct-num');
let skillsFired = false;

function fireSkills() {
  if (skillsFired) return;
  skillsFired = true;
  skillFills.forEach(bar => {
    const pct = bar.dataset.pct;
    const delay = parseInt(bar.dataset.delay) || 0;
    setTimeout(() => { bar.style.width = pct + '%'; }, delay);
  });
  skillPctNums.forEach(el => {
    const target = parseInt(el.dataset.pct);
    const delay = parseInt(el.dataset.delay) || 0;
    countUp(el, target, 1300, 0, delay);
  });
}

const skillsSection = document.getElementById('skills');
if (skillsSection) {
  const skillsIO = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting) { fireSkills(); skillsIO.disconnect(); }
  }, { threshold: 0.05 });
  skillsIO.observe(skillsSection);
}

// ── Active section (nav + chapter rail) ────────────────────────────────────
const navSections = ['top', 'story', 'skills', 'contact'];
const chapterIds = ['ch-01', 'ch-02', 'ch-03', 'ch-04', 'ch-05', 'ch-06'];
const navLinks = document.querySelectorAll('.nav-links a');
const railItems = document.querySelectorAll('.rail-item');
const siteNav = document.getElementById('site-nav');

function getActive(ids) {
  const mid = window.innerHeight * 0.35;
  let best = ids[0]; let bestDist = Infinity;
  for (const id of ids) {
    const el = document.getElementById(id);
    if (!el) continue;
    const r = el.getBoundingClientRect();
    if (r.top - mid <= 0) {
      const d = Math.abs(r.top - mid);
      if (d < bestDist) { bestDist = d; best = id; }
    }
  }
  return best;
}

function updateNav() {
  const active = getActive(navSections);
  navLinks.forEach(a => {
    const href = a.getAttribute('href').slice(1);
    a.classList.toggle('active', href === active);
  });
  if (siteNav) siteNav.classList.toggle('scrolled', window.scrollY > 80);
}

function updateRail() {
  const active = getActive(chapterIds);
  railItems.forEach(a => { a.classList.toggle('active', a.dataset.chapter === active); });
}

window.addEventListener('scroll', () => { updateNav(); updateRail(); }, { passive: true });
window.addEventListener('resize', () => { updateNav(); updateRail(); });
updateNav();
updateRail();
</script>
