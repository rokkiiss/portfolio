  .chapter-numeral { font-family: var(--display); font-weight: 500; font-size: clamp(80px, 11vw, 160px); line-height: .85; letter-spacing: -.04em; color: transparent; -webkit-text-stroke: 1px var(--fg-3); flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .chapter-meta-wrap { padding-top: 12px; flex: 1; min-width: 0; }
