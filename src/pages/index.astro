---
import Layout from '../layouts/Layout.astro';

const chapters = [
  {
    id: "ch-01",
    num: "06",
    tag: "June 2024 to Present",
    title: "Zero to Hero",
    where: "Jaydien Network Solutions · Brick, NJ",
    lede: "This is where everything I'd been building toward actually landed. Not just doing the work but owning it: the operations, the team, the strategy, and the outcomes.",
    points: [
      "Grew technician utilization from 20% to 70% through workflow redesign and automation",
      "Run end-to-end IT ops for a managed services firm serving regulated industries",
      "Manage the full Microsoft stack: Entra ID, Intune, Autopilot, M365, Exchange, SharePoint, Teams",
      "Oversaw cybersecurity, compliance, and risk mitigation — implementing CMMC L1 and L2 aligned with NIST 800-171",
      "Established business continuity and disaster recovery strategies across regulated environments",
      "Served as strategic technology advisor to executive leadership and client stakeholders",
      "Oversee network infrastructure across distributed offices: Meraki, VPN, and everything in between",
      "Mentor the team, own the metrics, and build the technology roadmap",
      "Deliver executive-level reporting on system health, risk, and investment priorities",
    ],
  },
  {
    id: "ch-02",
    num: "05",
    tag: "2022 to 2024",
    title: "Putting It All Into Practice",
    where: "AFScott · Bedminster, NJ",
    lede: "I came in with a playbook from Tech-Keys and a lot to prove. Left with SLA compliance up 40% and a team that actually ran like one.",
    points: [
      "Raised SLA compliance by 40% by fixing the underlying process, not just pushing harder",
      "Drove overall team productivity up by 85%",
      "Built PowerShell and Bash automation that eliminated hours of manual work per week",
      "Managed Azure AD, Active Directory, Hyper-V, VMware, and Citrix environments",
      "Rolled out Azure MFA, SSO, and Power Automate to tighten security and cut down on manual steps",
      "Handled client relationships and escalations across a multi-layered service delivery model",
    ],
  },
  {
    id: "ch-03",
    num: "04",
    tag: "2016 to 2022",
    title: "Found My Meaning in IT",
    where: "Tech-Keys · Howell, NJ",
    lede: "This is where I stopped just fixing things and started leading people. Six years, every rung of the ladder, and the point where I realized I was actually good at this.",
    points: [
      "Started as a Level 1 technician and worked up from the ground floor",
      "Managed and configured Aruba, Dell, Cisco switches and SonicWall firewalls",
      "Deployed and maintained Hyper-V, VMware, and Azure cloud environments",
      "Promoted to HelpDesk Manager, leading a team of 10+ support engineers across multiple countries",
      "Improved SLA response times by 50% for Tier 1 and 30% across all other tiers",
      "Implemented ITIL practices that brought structure and accountability to the team",
      "Built an educational program for interns and engineers to accelerate growth",
    ],
  },
  {
    id: "ch-04",
    num: "03",
    tag: "Pre-2016",
    title: "Coming Back to Tech",
    where: "Verizon Wireless · NJ",
    lede: "Verizon was the bridge back. Working at that scale taught me how tech decisions ripple out into real customer experience. It's also where I got serious about how I communicate, not just what I know.",
    points: [
      "Returned to technology after stepping away and traveling",
      "Gained exposure to enterprise-scale operations and how they touch customers directly",
      "Got serious about communication and explaining technical decisions to non-technical people",
      "Understood how IT choices at the top filter down into everyday customer experience",
    ],
  },
  {
    id: "ch-05",
    num: "02",
    tag: "The In-Between Years",
    title: "The Jobs That Didn't Make the Resume",
    where: "Various · NJ",
    lede: "After PC Warehouse, I took two jobs that taught me more about who I wasn't than who I was. One was a networking gig in a basement. The overtime was decent; the environment wasn't. The next was worse. One day, they made the decision for me. Best thing that ever happened.",
    points: [
      "Learned that a paycheck and a purpose are not the same thing",
      "Realized the environment you work in shapes you as much as the work itself",
      "Getting let go was the push I needed. Sometimes the door has to close",
      "Traveled on the last few cents I had and came back with a clearer head",
    ],
  },
  {
    id: "ch-06",
    num: "01",
    tag: "Age 14, Early Career",
    title: "It Started With a Burnt Motherboard",
    where: "PC Warehouse · NJ",
    lede: "At 14, I tried to overclock my computer and fried the Front Side Bus Controller. No money to fix it, no computer for the summer. Just a Windows 95 machine to tell my TeamSpeak crew I was offline. My mom pushed me to go ask for a job at the same shop. I was shy, went in reluctantly, and somehow walked out with an interview. I got the job.",
    points: [
      "Got my first job at 14 by walking in shy and leaving with an offer",
      "Stayed too long, honestly. A decade there when a few years would have done it",
      "But I learned hardware inside and out: components, repair, builds, diagnostics",
      "It was a late start in some ways. In others, it was exactly the foundation I needed",
    ],
  },
];

let _barIdx = 0;
const skillDomains = [
  {
    name: "Leadership & Strategy",
    skills: [
      { name: "Executive Leadership & Org Transformation", pct: 95 },
      { name: "Technology Strategy & IT Roadmap Development", pct: 93 },
      { name: "Digital Transformation & Business Modernization", pct: 90 },
      { name: "Operational Excellence & Performance Accountability", pct: 92 },
      { name: "Team Development & Talent Growth", pct: 93 },
      { name: "Vendor Strategy & Technology Investment", pct: 88 },
    ].map(s => ({ ...s, idx: _barIdx++ })),
  },
  {
    name: "Security & Compliance",
    skills: [
      { name: "Cybersecurity Governance & Risk Mitigation", pct: 88 },
      { name: "CMMC L1/L2 & NIST 800-171 Implementation", pct: 85 },
      { name: "Disaster Recovery & Business Continuity", pct: 85 },
    ].map(s => ({ ...s, idx: _barIdx++ })),
  },
  {
    name: "Infrastructure & Cloud",
    skills: [
      { name: "Microsoft 365, Entra ID, Intune & Autopilot", pct: 95 },
      { name: "Cloud & PaaS Architectures", pct: 88 },
      { name: "Network Infrastructure (Meraki, Cisco, SonicWall)", pct: 85 },
      { name: "Virtualization: Hyper-V, VMware, ProxMox", pct: 82 },
    ].map(s => ({ ...s, idx: _barIdx++ })),
  },
  {
    name: "Automation & Engineering",
    skills: [
      { name: "PowerShell & Bash Automation", pct: 90 },
      { name: "Power Automate & Workflow Design", pct: 85 },
      { name: "Identity & Access Management (MFA, SSO, AAD)", pct: 90 },
    ].map(s => ({ ...s, idx: _barIdx++ })),
  },
];

const toolTags = [
  "Microsoft Intune", "Autopilot", "Entra ID", "Azure AD", "Active Directory",
  "Meraki", "SonicWall", "Aruba", "Cisco", "Hyper-V", "VMware", "ProxMox",
  "Power Automate", "PowerShell", "Bash", "Azure MFA", "SSO", "Citrix",
  "SharePoint", "Teams", "Exchange", "M365", "ITIL", "CMMC",
];

const chapterIds = chapters.map(c => c.id);
---

<Layout title="Roger Anderson — Director of Operations & Technology" description="Director of Operations & Technology, NY Metro Area">

  <!-- NAV -->
  <header class="nav" id="site-nav">
    <div class="nav-inner">
      <a href="#top" class="nav-brand">
        <b>roger.anderson</b><span>/</span>operations-technology
      </a>
      <nav class="nav-links">
        <a href="#story">story</a>
        <a href="#skills">skills</a>
        <a href="#contact">contact</a>
      </nav>
      <a href="https://linkedin.com/in/rokis" target="_blank" rel="noopener" class="nav-cta">
        LinkedIn <span>↗</span>
      </a>
    </div>
  </header>

  <!-- HERO -->
  <section id="top" class="hero">
    <div class="hero-grid"></div>
    <div class="wrap hero-inner">
      <div class="hero-meta">
        <span class="live">Available · Open to conversations</span>
        <span>Director of Operations & Technology</span>
        <span>NY Metro Area</span>
      </div>
      <h1 class="hero-name">
        <span class="first">Roger</span>
        <span class="last">Anders<em>o</em>n</span>
      </h1>
      <p class="hero-tagline">
        <strong>Technology strategist and operations leader.</strong> I build accountable teams,
        drive digital transformation, and turn infrastructure into business outcomes
        across regulated industries and distributed organizations.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href="#story">Read the story <span class="arrow">↓</span></a>
        <a class="btn btn-ghost" href="mailto:roger@yeaitis.com">Get in touch <span class="arrow">→</span></a>
      </div>
    </div>

    <div class="wrap">
      <div class="metrics">

        <div class="metric-item">
          <div class="metric-num">
            <span class="metric-val" data-count="20" data-delay="0">0</span><span class="unit">+</span>
          </div>
          <div class="metric-label">Years in IT</div>
          <div class="metric-context">From hardware bench to executive strategy.</div>
        </div>

        <div class="metric-item">
          <div class="metric-trend">
            <span class="trend-from">20%</span>
            <span class="trend-sep">→</span>
            <span class="trend-to"><span class="metric-val" data-count="70" data-delay="120">0</span>%</span>
          </div>
          <svg viewBox="0 0 100 28" class="sparkline" aria-hidden="true" preserveAspectRatio="none">
            <polyline class="spark-line" points="0,26 20,23 40,18 60,11 80,5 100,1"/>
          </svg>
          <div class="metric-label">Utilization Growth</div>
          <div class="metric-context">Technicians at Jaydien, rebuilt from near zero.</div>
        </div>

        <div class="metric-item">
          <div class="metric-num">
            <span class="metric-val" data-count="50" data-delay="240">0</span><span class="unit">%</span>
          </div>
          <svg viewBox="0 0 100 28" class="sparkline" aria-hidden="true" preserveAspectRatio="none">
            <polyline class="spark-line" points="0,26 20,22 40,17 60,12 80,6 100,2"/>
          </svg>
          <div class="metric-label">Faster SLA Resolution</div>
          <div class="metric-context">Tier 1 response times at Tech-Keys.</div>
        </div>

        <div class="metric-item">
          <div class="metric-num">
            <span class="metric-val" data-count="85" data-delay="360">0</span><span class="unit">%</span>
          </div>
          <svg viewBox="0 0 100 28" class="sparkline" aria-hidden="true" preserveAspectRatio="none">
            <polyline class="spark-line" points="0,26 20,24 40,19 60,13 80,6 100,1"/>
          </svg>
          <div class="metric-label">Productivity Lift</div>
          <div class="metric-context">Team output at AFScott, post-overhaul.</div>
        </div>

        <div class="metric-item">
          <div class="metric-badge">L1 + L2</div>
          <div class="metric-label">CMMC Implemented</div>
          <div class="metric-context">NIST 800-171 across regulated client environments.</div>
        </div>

        <div class="metric-item">
          <div class="metric-num">
            <span class="metric-val" data-count="10" data-delay="600">0</span><span class="unit">+</span>
          </div>
          <div class="metric-label">Engineers Led</div>
          <div class="metric-context">Across distributed locations and multiple countries.</div>
        </div>

      </div>
    </div>
  </section>

  <!-- STORY / TIMELINE -->
  <section id="story" class="story">
    <div class="wrap">
      <div class="timeline-head reveal">
        <div>
          <div class="eyebrow">The Journey</div>
          <h2 class="section-title">Every stop shaped <em>what came next.</em></h2>
        </div>
        <p>
          Twenty years across hardware repair shops, enterprise IT, managed services,
          and the director seat. Each stop built something the next one needed.
        </p>
      </div>

      <div class="timeline">
        <nav class="rail" aria-label="Chapters" id="chapter-rail">
          {chapters.map((c) => (
            <a href={`#${c.id}`} class="rail-item" data-chapter={c.id}>
              <span class="num">CHAPTER {c.num}</span>
              <span class="place">{c.where.split(" · ")[0]}</span>
            </a>
          ))}
        </nav>

        <div class="chapters">
          {chapters.map((c) => (
            <article id={c.id} class="chapter reveal">
              <header class="chapter-head">
                <div class="chapter-numeral">{c.num}</div>
                <div class="chapter-meta-wrap">
                  <div class="chapter-tag">Chapter {c.num} · {c.tag}</div>
                  <h3 class="chapter-title">{c.title}</h3>
                  <div class="chapter-where"><span class="dot"></span>{c.where}</div>
                </div>
              </header>
              <div class="chapter-body">
                <p class="chapter-lede">{c.lede}</p>
                <ul class="achievements">
                  {c.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="skills">
    <div class="wrap">
      <div class="reveal">
        <div class="eyebrow">Capabilities</div>
        <h2 class="section-title">Where I <em>operate.</em></h2>
      </div>

      <div class="domains-grid">
        {skillDomains.map((domain) => (
          <div class="domain reveal">
            <div class="domain-header">
              <h3 class="domain-name">{domain.name}</h3>
            </div>
            <div class="skill-list">
              {domain.skills.map((s) => (
                <div class="skill-row">
                  <div class="skill-row-head">
                    <span class="skill-name">{s.name}</span>
                    <span class="skill-pct"><span class="skill-pct-num" data-pct={s.pct} data-delay={s.idx * 55}>0</span>%</span>
                  </div>
                  <div class="skill-bar">
                    <div class="skill-bar-fill" data-pct={s.pct} data-delay={s.idx * 55}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="tools-row reveal">
        <div class="domain-header">
          <h3 class="domain-name">Tools & Platforms</h3>
        </div>
        <div class="tags">
          {toolTags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>

      <div class="languages-row reveal">
        <div class="domain-header">
          <h3 class="domain-name">Languages</h3>
        </div>
        <div class="lang-list">
          <span class="lang-tag">English</span>
          <span class="lang-tag">Portuguese</span>
          <span class="lang-tag">Spanish</span>
        </div>
      </div>

    </div>
  </section>

  <!-- CONTACT + FOOTER -->
  <section id="contact" class="contact">
    <div class="wrap">
      <div class="contact-inner">
        <div class="reveal">
          <div class="eyebrow">Let's connect</div>
          <h2 class="contact-cta">
            Open to new opportunities, consulting conversations, or just a <em>good IT chat.</em>
          </h2>
          <p class="contact-blurb">
            Based in the NY metro area. Email is best; I usually respond same day.
          </p>
        </div>

        <div class="contact-card reveal">
          <div class="label">Direct lines</div>
          <a href="mailto:roger@yeaitis.com" class="contact-line">
            <span class="what">email</span>
            <span class="val">roger@yeaitis.com <span class="arrow">↗</span></span>
          </a>
          <a href="https://linkedin.com/in/rokis" target="_blank" rel="noopener" class="contact-line">
            <span class="what">linkedin</span>
            <span class="val">/in/rokis <span class="arrow">↗</span></span>
          </a>
          <a href="https://github.com/rokkiiss" target="_blank" rel="noopener" class="contact-line">
            <span class="what">github</span>
            <span class="val">@rokkiiss <span class="arrow">↗</span></span>
          </a>
          <div class="contact-line">
            <span class="what">location</span>
            <span class="val">NY Metro Area</span>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div class="wrap footer-inner">
        <div>© 2025 Roger Anderson · Director of Operations & Technology</div>
        <div class="footer-links">
          <a href="#top">↑ Top</a>
          <a href="#story">Story</a>
          <a href="#skills">Skills</a>
          <a href="mailto:roger@yeaitis.com">Email</a>
        </div>
      </div>
    </footer>
  </section>

</Layout>

<style is:global>
  .wrap { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--gutter); }

  /* ── Nav ── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    border-bottom: 1px solid var(--line);
    transition: background .35s ease;
  }
  .nav.scrolled { background: color-mix(in oklab, var(--bg) 92%, transparent); }
  .nav-inner {
    max-width: var(--max-w); margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .nav-brand {
    font-family: var(--mono); font-size: 12px; letter-spacing: .02em;
    color: var(--fg-2); display: inline-flex; align-items: center; gap: 8px;
  }
  .nav-brand::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 12px var(--accent);
  }
  .nav-brand b { color: var(--fg); font-weight: 500; }
  .nav-links { display: flex; gap: 4px; align-items: center; font-family: var(--mono); font-size: 12px; }
  .nav-links a { padding: 8px 12px; border-radius: 8px; color: var(--fg-2); transition: color .2s, background .2s; }
  .nav-links a:hover { color: var(--fg); background: var(--bg-2); }
  .nav-links a.active { color: var(--accent); }
  .nav-cta {
    font-family: var(--mono); font-size: 12px; padding: 8px 12px;
    border: 1px solid var(--line-strong); border-radius: 8px; color: var(--fg);
    display: inline-flex; align-items: center; gap: 6px; transition: border-color .2s, background .2s;
  }
  .nav-cta:hover { border-color: var(--accent); background: var(--accent-soft); }

  /* ── Shared ── */
  .eyebrow {
    font-family: var(--mono); font-size: 11px;
    letter-spacing: .14em; text-transform: uppercase; color: var(--fg-3);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .eyebrow::before { content: ""; width: 24px; height: 1px; background: var(--accent); }
  .section-title {
    font-family: var(--display); font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02; letter-spacing: -.02em; font-weight: 500; margin: 16px 0 0; color: var(--fg);
  }
  .section-title em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); letter-spacing: -.01em; }
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); }
  .reveal.in { opacity: 1; transform: none; }
  section { padding-top: var(--pad-sec); padding-bottom: var(--pad-sec); }

  /* ── Hero ── */
  .hero { min-height: 100vh; display: flex; flex-direction: column; padding-top: 96px; padding-bottom: 0; position: relative; overflow: hidden; }
  .hero-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 80px 80px; background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 30%, transparent 100%);
    pointer-events: none;
  }
  .hero-inner { flex: 1; display: flex; flex-direction: column; justify-content: center; position: relative; padding: 80px 0 60px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 12px 24px; font-family: var(--mono); font-size: 12px; color: var(--fg-2); margin-bottom: 32px; }
  .hero-meta span { display: inline-flex; align-items: center; gap: 8px; }
  .hero-meta span::before { content: ""; width: 6px; height: 6px; border-radius: 1px; background: var(--fg-3); }
  .hero-meta .live::before { background: var(--accent); box-shadow: 0 0 10px var(--accent); animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  .hero-name { font-family: var(--display); font-weight: 500; font-size: clamp(56px, 11vw, 168px); line-height: .92; letter-spacing: -.04em; margin: 0; color: var(--fg); }
  .hero-name .first, .hero-name .last { display: block; }
  .hero-name .last em { font-family: var(--serif); font-style: italic; color: var(--accent); font-weight: 400; letter-spacing: -.02em; }
  .hero-tagline { margin: 40px 0 0; max-width: 640px; font-family: var(--body); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.55; color: var(--fg-2); font-weight: 300; }
  .hero-tagline strong { color: var(--fg); font-weight: 500; }
  .hero-cta-row { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px; }
  .btn { font-family: var(--mono); font-size: 13px; padding: 14px 20px; border-radius: 10px; display: inline-flex; align-items: center; gap: 10px; transition: transform .2s, background .2s, border-color .2s, color .2s, box-shadow .2s; cursor: pointer; }
  .btn-primary { background: var(--accent); color: #0a0d12; border: 1px solid var(--accent); font-weight: 500; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px -8px var(--accent); }
  .btn-ghost { border: 1px solid var(--line-strong); background: transparent; color: var(--fg); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn .arrow { display: inline-block; transition: transform .25s ease; }
  .btn:hover .arrow { transform: translateX(4px); }

  /* ── Metrics ── */
  .metrics {
    border-top: 1px solid var(--line); padding: 32px 0 40px;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 32px;
  }
  @media (max-width: 900px) { .metrics { grid-template-columns: repeat(2, 1fr); gap: 28px; } }
  @media (max-width: 500px) { .metrics { grid-template-columns: 1fr; } }
  .metric-item { display: flex; flex-direction: column; gap: 6px; }
  .metric-num {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(36px, 4vw, 60px); line-height: 1; letter-spacing: -.03em;
    color: var(--fg); font-variant-numeric: tabular-nums;
    display: flex; align-items: baseline; gap: 4px;
  }
  .metric-num .unit { color: var(--accent); font-size: .5em; font-family: var(--mono); font-weight: 400; }
  .metric-trend {
    display: flex; align-items: baseline; gap: 8px;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(28px, 3.2vw, 52px); line-height: 1; letter-spacing: -.03em;
  }
  .trend-from { color: var(--fg-3); font-size: .55em; text-decoration: line-through; text-decoration-color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .trend-sep { color: var(--accent); font-size: .5em; font-family: var(--mono); font-weight: 400; }
  .trend-to { color: var(--fg); font-variant-numeric: tabular-nums; }
  .metric-badge {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(32px, 3.6vw, 56px); line-height: 1; letter-spacing: -.03em;
    color: var(--accent);
  }
  .metric-label { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-3); margin-top: 2px; }
